diff --git a/builder/build-omarchy-packages.sh b/builder/build-omarchy-packages.sh
--- a/builder/build-omarchy-packages.sh
+++ b/builder/build-omarchy-packages.sh
@@ -42,6 +42,9 @@
   "$OMARCHY_NVIM_PACKAGE"
 )
 
+source /builder/custom-packages.sh
+packages+=("${CUSTOM_LOCAL_PACKAGES[@]}")
+
 # Local-source packages must replace every cached build of the same package,
 # even when the checkout's generated pkgver sorts below a published build.
 # Otherwise the later generic cache pruning can silently keep edge instead.
@@ -68,5 +71,23 @@
     makepkg --noconfirm --skippgpcheck --skipchecksums --nodeps -f
   "
+  # Only explicitly selected library providers are installed into the builder.
+  # Do not activate an authentication-policy package in the build container.
+  for provider_name in "${CUSTOM_BUILD_INSTALL_PACKAGES[@]}"; do
+    [[ $provider_name == "$pkg" ]] || continue
+    provider_file=""
+    for candidate in "$work_dir/$pkg-"*.pkg.tar.zst; do
+      [[ -f $candidate ]] || continue
+      read -r candidate_name _ < <(pacman -Qp "$candidate")
+      [[ $candidate_name == "$pkg" ]] || continue
+      if [[ -n $provider_file ]]; then
+        echo "ERROR: multiple local build providers for $pkg" >&2
+        exit 1
+      fi
+      provider_file="$candidate"
+    done
+    [[ -n $provider_file ]] || { echo "ERROR: missing local build provider $pkg" >&2; exit 1; }
+    pacman --noconfirm -U --needed "$provider_file"
+  done
 done
 
