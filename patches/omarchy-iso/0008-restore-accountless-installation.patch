+class AccountlessInstaller(Installer):
+    """Run install commands directly in the mounted target.
+
+    Archinstall 4.4's -S path starts a transient systemd service and resolves
+    the target root account by name. Plain arch-chroot uses the numeric UID 0
+    already held by this installer and needs no account or login transition.
+    """
+
+    def run_command(self, cmd: str, peek_output: bool = False) -> SysCommand:
+        return SysCommand(
+            ["arch-chroot", str(self.target), *shlex.split(cmd)],
+            peek_output=peek_output,
+        )
+
+    def _chroot_argv(self, *args: str) -> list[str]:
+        return ["arch-chroot", str(self.target), *args]
+
+    def arch_chroot(self, cmd: str, run_as: str | None = None, peek_output: bool = False) -> SysCommand:
+        if run_as is not None:
+            raise RuntimeError("This installation profile has no target login user")
+        return self.run_command(cmd, peek_output=peek_output)
+
