diff --git a/builder/build-iso.sh b/builder/build-iso.sh
--- a/builder/build-iso.sh
+++ b/builder/build-iso.sh
@@ -1,6 +1,7 @@
 #!/bin/bash
 
 set -e
+set -o pipefail
 
 OMARCHY_ISO_REF="${OMARCHY_ISO_REF:-quattro}"
 OMARCHY_MIRROR="${OMARCHY_MIRROR:-stable}"
@@ -105,10 +106,12 @@
 fi
 
 # Node.js binary for offline mise install.
-NODE_DIST_URL="https://nodejs.org/dist/latest"
-NODE_SHASUMS=$(curl -fsSL "$NODE_DIST_URL/SHASUMS256.txt")
-NODE_FILENAME=$(echo "$NODE_SHASUMS" | grep "linux-x64.tar.gz" | awk '{print $2}')
-NODE_SHA=$(echo "$NODE_SHASUMS" | grep "linux-x64.tar.gz" | awk '{print $1}')
+NODE_DIST_URL="https://nodejs.org/dist/${OMARCHY_NODE_VERSION:?}"
+NODE_FILENAME="node-${OMARCHY_NODE_VERSION}-linux-x64.tar.gz"
+NODE_SHA="${OMARCHY_NODE_SHA256:?}"
+[[ $OMARCHY_NODE_VERSION =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || exit 1
+[[ $NODE_SHA =~ ^[0-9a-f]{64}$ ]] || exit 1
+printf '%s  %s\n' "$NODE_SHA" "$NODE_FILENAME" > /out/node-dist.sha256
 curl -fsSL "$NODE_DIST_URL/$NODE_FILENAME" -o "/tmp/$NODE_FILENAME"
 echo "$NODE_SHA /tmp/$NODE_FILENAME" | sha256sum -c -
 mkdir -p "$build_cache_dir/airootfs/opt/packages/"
@@ -356,6 +359,10 @@
 # Live ISO uses the same offline pacman.conf.
 cp "$build_cache_dir/pacman-offline.conf" "$build_cache_dir/airootfs/etc/pacman.conf"
 
+# Record the actual rolling-mirror selections; source pins alone do not pin these.
+pacman -Q > /out/build-environment-packages.txt
+printf '%s\n' "${required_package_files[@]}" | sort > /out/offline-packages.txt
+
 # Build the ISO.
 mkarchiso -v -w "$build_cache_dir/work/" -o /out/ "$build_cache_dir/"
 
