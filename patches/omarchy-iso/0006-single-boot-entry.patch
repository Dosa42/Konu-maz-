diff --git a/builder/build-iso.sh b/builder/build-iso.sh
index aa2feb3..68ee588 100755
--- a/builder/build-iso.sh
+++ b/builder/build-iso.sh
@@ -64,6 +64,14 @@ rm -rf "$build_cache_dir/airootfs/etc/xdg/reflector"
 
 # Bring in our archiso profile additions.
 cp -r /configs/* "$build_cache_dir/"
+# The overlay cannot delete files inherited from releng. Remove alternate boot
+# configurations explicitly after the merge. The selected bootmodes are BIOS
+# Syslinux and UEFI GRUB; efiboot belongs to the unused systemd-boot profile.
+rm -rf -- "$build_cache_dir/efiboot"
+rm -f -- "$build_cache_dir/grub/loopback.cfg" \
+  "$build_cache_dir/syslinux/archiso_pxe.cfg" \
+  "$build_cache_dir/syslinux/archiso_pxe-linux.cfg" \
+  "$build_cache_dir/syslinux/archiso_tail.cfg"
 mkdir -p "$build_cache_dir/airootfs/usr/share/omarchy-iso"
 echo "$OMARCHY_MIRROR" > "$build_cache_dir/airootfs/root/omarchy_mirror"
 echo "$OMARCHY_ISO_REF" > "$build_cache_dir/airootfs/root/omarchy_iso_ref"
